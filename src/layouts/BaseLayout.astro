---
import '../styles/global.css'
import { basePath } from '../utils/basePath'

interface Props {
  title?: string
  description?: string
  image?: string
  canonicalURL?: URL
  article?: boolean
  pageClass?: string
  themeColor?: string
}

const {
  title = 'Michael Anslow — Researcher / Innovator',
  description = 'Research, creative systems and ideas at the intersection of artificial intelligence, experience and society.',
  image = `${basePath}social-card.png`,
  canonicalURL: canonicalProp,
  article = false,
  pageClass,
  themeColor = '#f2efe5',
} = Astro.props

const pageURL = new URL(Astro.url.pathname, Astro.site)
const canonicalURL = canonicalProp ?? pageURL
const imageURL = new URL(image, Astro.site)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Michael Anslow — Notes"
      href={`${basePath}rss.xml`}
    />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <slot />
  </body>
</html>
